# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://quickbite:quickbite@localhost:5432/quickbite

# Comma separated. "*" is fine for a mobile-only API.
CORS_ORIGINS=*

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ---- Payments -------------------------------------------------------------
# Razorpay TEST keys from https://dashboard.razorpay.com (Test Mode). Leave empty
# to use the clearly labelled mock payment provider.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOCK_PAYMENTS=true

# ---- Social sign-in ---------------------------------------------------------
# Your iOS bundle id (audience of Apple identity tokens)
APPLE_BUNDLE_ID=com.quickbite.app
# OAuth client id(s) from Google Cloud console, comma separated
GOOGLE_CLIENT_IDS=
# Accept "demo:<email>" identity tokens. Development / demo only.
SOCIAL_LOGIN_DEMO=true

# ---- Push notifications (Firebase Cloud Messaging HTTP v1) ------------------
# From a Firebase service-account JSON. Leave empty to store notifications
# in-app only (the app shows them in its notification inbox).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ---- Demo helpers -----------------------------------------------------------
# Auto-advance orders through each status so tracking can be demonstrated.
DEMO_ORDER_PROGRESSION=true
DEMO_STEP_SECONDS=20
# Lets you move orders with:  curl -H "x-admin-key: ..." PATCH /api/v1/admin/orders/:id/status
ADMIN_API_KEY=change-me-admin
